{
    "name": "lab",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.12.1",
    "workspaces": [
        "app",
        "packages/*"
    ],
    "scripts": {
        "dev": "pnpm --filter @lab/app dev",
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "preview": "pnpm --filter @lab/app preview",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.8.4",
        "typescript": "^5.8.3",
        "vitest": "^4.1.9"
    }
}
